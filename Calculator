<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#101522"><title>All-in-One Calculator</title>
<style>
:root{--bg:#101522;--panel:#192235;--key:#26334b;--text:#f7f8fc;--muted:#9aa8bf;--accent:#65d6b3;--op:#344c66;--line:#34435d;--shadow:#080d17}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,Arial,sans-serif;min-height:100dvh;padding:12px;display:flex;justify-content:center}
.app{width:min(100%,480px);min-height:calc(100dvh - 24px);background:var(--panel);border-radius:26px;padding:16px;box-shadow:0 18px 55px #0005;display:flex;flex-direction:column;gap:13px}
header{display:flex;align-items:center;justify-content:space-between}.brand{font-weight:900;letter-spacing:1.5px}.brand span{color:var(--accent)}button,input,select{font:inherit}.iconbtn{border:0;background:var(--key);color:var(--text);border-radius:12px;padding:9px 12px;font-size:17px}
.tabs{display:flex;gap:7px;overflow-x:auto;padding:2px 1px 8px;scrollbar-width:thin}.tab{white-space:nowrap;border:1px solid var(--line);background:var(--key);color:var(--muted);border-radius:20px;padding:9px 13px;font-size:12px;font-weight:750}.tab.active{background:var(--accent);color:#09251e;border-color:var(--accent)}
.view{display:none;flex:1;flex-direction:column;gap:12px}.view.active{display:flex}
.display{background:var(--bg);border-radius:19px;padding:16px;min-height:135px;display:flex;flex-direction:column;justify-content:flex-end;gap:9px;overflow:hidden}.label{font-size:11px;letter-spacing:1.5px;color:var(--muted);font-weight:800}.expression{text-align:right;color:var(--muted);min-height:22px;overflow-wrap:anywhere}.result{text-align:right;font-size:clamp(35px,9vw,49px);font-weight:700;overflow-wrap:anywhere}
.keys{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;flex:1;grid-auto-rows:minmax(48px,1fr)}.key{border:0;border-radius:15px;background:var(--key);color:var(--text);font-size:21px;font-weight:650;box-shadow:0 3px 0 var(--shadow)}.key:active,.action:active{transform:translateY(2px)}.fn{color:var(--accent);font-size:16px}.op{background:var(--op)}.eq{background:var(--accent);color:#08251d}.wide{grid-column:span 2}
.sectionTitle{font-size:19px;font-weight:850;margin:0}.sub{color:var(--muted);font-size:12px;line-height:1.5;margin:0}
.field{display:flex;flex-direction:column;gap:6px}.field label{font-size:12px;color:var(--muted);font-weight:700}.field input,.field select{width:100%;border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:12px;padding:13px;font-size:16px;outline:none}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.action{border:0;border-radius:13px;background:var(--accent);color:#08251d;padding:13px;font-weight:850}.secondary{background:var(--key);color:var(--text);border:1px solid var(--line)}
.output{background:var(--bg);border:1px solid var(--line);border-radius:15px;padding:15px;min-height:76px}.bigout{font-size:25px;font-weight:850;color:var(--accent);overflow-wrap:anywhere}.history{max-height:170px;overflow:auto}.historyRow{border-bottom:1px solid var(--line);padding:9px 2px;display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:13px}
footer{text-align:center;color:var(--muted);font-size:10px;padding:3px}
body.light{--bg:#edf2f7;--panel:#fff;--key:#e3eaf2;--text:#172033;--muted:#68758a;--accent:#0c9479;--op:#d3e1ed;--line:#cbd5e1;--shadow:#c2ccd8}
@media(max-height:700px){body{padding:6px}.app{min-height:calc(100dvh - 12px);padding:11px;gap:9px}.display{min-height:100px}.keys{gap:7px;grid-auto-rows:minmax(42px,1fr)}}
</style></head>
<body><main class="app">
<header><div class="brand">ALL-IN-ONE <span>CALCULATOR</span></div><button class="iconbtn" id="theme" aria-label="Theme">☼</button></header>
<nav class="tabs" id="tabs">
<button class="tab active" data-view="standard">Standard</button><button class="tab" data-view="scientific">Scientific</button><button class="tab" data-view="percentage">Percentage</button><button class="tab" data-view="discount">Discount</button><button class="tab" data-view="converter">Converter</button><button class="tab" data-view="date">Date</button>
</nav>
<section class="view active" id="standard">
<div class="display"><div class="label">STANDARD CALCULATOR</div><div class="expression" id="stdExpr"></div><div class="result" id="stdResult">0</div></div>
<div class="keys" id="stdKeys">
<button class="key fn" data-a="clear">AC</button><button class="key fn" data-a="sign">+/−</button><button class="key fn" data-a="percent">%</button><button class="key op" data-v="÷">÷</button>
<button class="key" data-v="7">7</button><button class="key" data-v="8">8</button><button class="key" data-v="9">9</button><button class="key op" data-v="×">×</button>
<button class="key" data-v="4">4</button><button class="key" data-v="5">5</button><button class="key" data-v="6">6</button><button class="key op" data-v="−">−</button>
<button class="key" data-v="1">1</button><button class="key" data-v="2">2</button><button class="key" data-v="3">3</button><button class="key op" data-v="+">+</button>
<button class="key fn" data-a="back">⌫</button><button class="key wide" data-v="0">0</button><button class="key" data-v=".">.</button>
<button class="key eq wide" data-a="equals">=</button><button class="key fn wide" data-a="history">HISTORY</button>
</div><div class="history" id="stdHistory"></div></section>
<section class="view" id="scientific">
<div><h2 class="sectionTitle">Scientific Calculator</h2><p class="sub">Trigonometry uses degrees. Supports square, square root, powers and logarithms.</p></div>
<div class="display"><div class="label">SCIENTIFIC RESULT</div><div class="expression" id="sciExpr"></div><div class="result" id="sciResult">0</div></div>
<div class="grid3" id="sciKeys">
<button class="key fn" data-f="sin">sin</button><button class="key fn" data-f="cos">cos</button><button class="key fn" data-f="tan">tan</button>
<button class="key fn" data-f="sqrt">√x</button><button class="key fn" data-f="square">x²</button><button class="key fn" data-f="cube">x³</button>
<button class="key fn" data-f="log">log</button><button class="key fn" data-f="ln">ln</button><button class="key fn" data-f="abs">|x|</button>
<button class="key fn" data-f="pi">π</button><button class="key fn" data-f="exp">eˣ</button><button class="key fn" data-f="recip">1/x</button>
</div>
<div class="grid2"><div class="field"><label>Enter a number</label><input id="sciInput" type="number" inputmode="decimal" placeholder="e.g. 45"></div><div class="field"><label>Power (for xʸ)</label><input id="sciPower" type="number" inputmode="decimal" placeholder="e.g. 2"></div></div>
<button class="action" id="powerBtn">Calculate xʸ</button><div class="output"><div class="label">ANSWER</div><div class="bigout" id="sciOut">—</div></div>
</section>
<section class="view" id="percentage">
<div><h2 class="sectionTitle">Percentage Calculator</h2><p class="sub">Find a percentage of a number, or find what percentage one number is of another.</p></div>
<div class="field"><label>What is this percentage?</label><input id="pctRate" type="number" inputmode="decimal" placeholder="e.g. 15"></div>
<div class="field"><label>Of this number</label><input id="pctBase" type="number" inputmode="decimal" placeholder="e.g. 800"></div>
<button class="action" id="pctBtn">Calculate percentage</button><div class="output"><div class="label">RESULT</div><div class="bigout" id="pctOut">—</div><p class="sub" id="pctExplain"></p></div>
<div class="field"><label>What percentage is value A of value B?</label><div class="grid2"><input id="pctA" type="number" placeholder="Value A" inputmode="decimal"><input id="pctB" type="number" placeholder="Value B" inputmode="decimal"></div></div>
<button class="action secondary" id="pctOfBtn">Find percentage</button><div class="output"><div class="bigout" id="pctOfOut">—</div></div>
</section>
<section class="view" id="discount">
<div><h2 class="sectionTitle">Discount Calculator</h2><p class="sub">Work out the sale price and how much money is saved.</p></div>
<div class="field"><label>Original price</label><input id="price" type="number" inputmode="decimal" placeholder="e.g. 2500"></div>
<div class="field"><label>Discount percentage (%)</label><input id="discountRate" type="number" inputmode="decimal" placeholder="e.g. 20"></div>
<button class="action" id="discountBtn">Calculate discount</button><div class="output"><div class="label">FINAL PRICE</div><div class="bigout" id="finalPrice">—</div><p class="sub" id="saving"></p></div>
</section>
<section class="view" id="converter">
<div><h2 class="sectionTitle">Unit Converter</h2><p class="sub">Convert common length, weight and temperature units.</p></div>
<div class="field"><label>Category</label><select id="category"><option value="length">Length</option><option value="weight">Weight</option><option value="temperature">Temperature</option></select></div>
<div class="field"><label>Value</label><input id="convValue" type="number" inputmode="decimal" placeholder="Enter value"></div>
<div class="grid2"><div class="field"><label>From</label><select id="fromUnit"></select></div><div class="field"><label>To</label><select id="toUnit"></select></div></div>
<button class="action" id="convertBtn">Convert</button><div class="output"><div class="label">CONVERTED VALUE</div><div class="bigout" id="convOut">—</div></div>
</section>
<section class="view" id="date">
<div><h2 class="sectionTitle">Date Difference</h2><p class="sub">Find the number of days between two dates.</p></div>
<div class="field"><label>Start date</label><input id="date1" type="date"></div><div class="field"><label>End date</label><input id="date2" type="date"></div>
<button class="action" id="dateBtn">Calculate days</button><div class="output"><div class="label">TIME BETWEEN DATES</div><div class="bigout" id="dateOut">—</div><p class="sub" id="dateExplain"></p></div>
</section>
<footer>PRO CALCULATOR • Simple tools for everyday maths</footer>
</main>
<script>
const $=id=>document.getElementById(id),fmt=n=>Number.isFinite(n)?Number(n.toPrecision(12)).toLocaleString('en-US',{maximumFractionDigits:10}):'Cannot calculate';
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x.id===b.dataset.view))});
$('theme').onclick=()=>{document.body.classList.toggle('light');$('theme').textContent=document.body.classList.contains('light')?'☾':'☼'};
// Standard calculator
let cur='0',saved=null,op=null,wait=false,history=[];
function renderStd(expr=''){$('stdResult').textContent=cur;$('stdExpr').textContent=expr}
function digit(v){if(wait){cur=v==='.'?'0.':v;wait=false}else if(v==='.'){if(!cur.includes('.'))cur+='.'}else cur=cur==='0'?v:cur.length<16?cur+v:cur;renderStd()}
function calc(a,b,o){return o==='+'?a+b:o==='−'?a-b:o==='×'?a*b:o==='÷'?(b===0?NaN:a/b):b}
function choose(o){if(cur==='Error')return;if(op&&!wait){saved=calc(saved,Number(cur),op);cur=fmt(saved)}else saved=Number(cur);op=o;wait=true;renderStd(fmt(saved)+' '+o)}
function equal(){if(!op||saved===null)return;let a=saved,b=Number(cur),o=op,r=calc(a,b,o),expr=fmt(a)+' '+o+' '+fmt(b)+' =';cur=fmt(r);history.unshift({expr,result:cur});history=history.slice(0,30);saved=null;op=null;wait=true;renderStd(expr);showHist()}
function showHist(){$('stdHistory').innerHTML=history.slice(0,5).map(x=>`<div class="historyRow"><span>${x.expr}</span><b>${x.result}</b></div>`).join('')}
$('stdKeys').onclick=e=>{let b=e.target.closest('button');if(!b)return;let v=b.dataset.v,a=b.dataset.a;if(v!==undefined){['+','−','×','÷'].includes(v)?choose(v):digit(v)}else if(a==='clear'){cur='0';saved=null;op=null;wait=false;renderStd()}else if(a==='sign'){if(cur!=='0')cur=cur.startsWith('-')?cur.slice(1):'-'+cur;renderStd()}else if(a==='percent'){cur=fmt(Number(cur)/100);renderStd()}else if(a==='back'){if(!wait)cur=cur.length>1?cur.slice(0,-1):'0';renderStd()}else if(a==='equals')equal();else if(a==='history')showHist()};
document.addEventListener('keydown',e=>{if(/^[0-9.]$/.test(e.key)&&$('standard').classList.contains('active'))digit(e.key);else if(e.key==='Enter'&&$('standard').classList.contains('active'))equal();else if(e.key==='Backspace'&&$('standard').classList.contains('active')){cur=cur.length>1?cur.slice(0,-1):'0';renderStd()}});
// Scientific
function sci(fn){let x=Number($('sciInput').value),v;switch(fn){case'sin':v=Math.sin(x*Math.PI/180);break;case'cos':v=Math.cos(x*Math.PI/180);break;case'tan':v=Math.tan(x*Math.PI/180);break;case'sqrt':v=Math.sqrt(x);break;case'square':v=x*x;break;case'cube':v=x*x*x;break;case'log':v=Math.log10(x);break;case'ln':v=Math.log(x);break;case'abs':v=Math.abs(x);break;case'pi':v=Math.PI;break;case'exp':v=Math.exp(x);break;case'recip':v=1/x;break} $('sciExpr').textContent=fn+'('+($('sciInput').value||'')+')';$('sciOut').textContent=fmt(v);$('sciResult').textContent=fmt(v)}
$('sciKeys').onclick=e=>{let b=e.target.closest('[data-f]');if(!b)return;if(b.dataset.f==='pi'&&$('sciInput').value==='')$('sciInput').value=Math.PI;sci(b.dataset.f)};
$('powerBtn').onclick=()=>{let x=Number($('sciInput').value),y=Number($('sciPower').value);$('sciOut').textContent=fmt(Math.pow(x,y));$('sciExpr').textContent=x+' ^ '+y};
// Percentage
$('pctBtn').onclick=()=>{let r=Number($('pctRate').value),b=Number($('pctBase').value),v=r/100*b;$('pctOut').textContent=fmt(v);$('pctExplain').textContent=fmt(r)+'% of '+fmt(b)+' = '+fmt(v)};
$('pctOfBtn').onclick=()=>{let a=Number($('pctA').value),b=Number($('pctB').value);$('pctOfOut').textContent=b===0?'Cannot divide by zero':fmt(a/b*100)+'%'};
// Discount
$('discountBtn').onclick=()=>{let p=Number($('price').value),r=Number($('discountRate').value),s=p*r/100;$('finalPrice').textContent=fmt(p-s);$('saving').textContent='You save '+fmt(s)+' ('+fmt(r)+'% discount)'};
// Unit conversion
const units={
 length:{m:1,km:1000,cm:.01,mm:.001,mile:1609.344,foot:.3048,inch:.0254},
 weight:{kg:1,g:.001,mg:.000001,lb:.45359237,oz:.028349523125},
 temperature:{C:1,F:1,K:1}
};
const names={m:'Meter (m)',km:'Kilometer (km)',cm:'Centimeter (cm)',mm:'Millimeter (mm)',mile:'Mile',foot:'Foot',inch:'Inch',kg:'Kilogram (kg)',g:'Gram (g)',mg:'Milligram (mg)',lb:'Pound (lb)',oz:'Ounce (oz)',C:'Celsius (°C)',F:'Fahrenheit (°F)',K:'Kelvin (K)'};
function fillUnits(){let c=$('category').value,keys=Object.keys(units[c]);$('fromUnit').innerHTML=keys.map(k=>`<option value="${k}">${names[k]}</option>`).join('');$('toUnit').innerHTML=keys.map(k=>`<option value="${k}">${names[k]}</option>`).join('');if(keys.length>1)$('toUnit').selectedIndex=1}
$('category').onchange=fillUnits;fillUnits();
$('convertBtn').onclick=()=>{let v=Number($('convValue').value),c=$('category').value,f=$('fromUnit').value,t=$('toUnit').value,r;if(c==='temperature'){let cel=f==='C'?v:f==='F'?(v-32)*5/9:v-273.15;r=t==='C'?cel:t==='F'?cel*9/5+32:cel+273.15}else r=v*units[c][f]/units[c][t];$('convOut').textContent=fmt(r)+' '+t};
// Date difference
$('dateBtn').onclick=()=>{let a=$('date1').value,b=$('date2').value;if(!a||!b){$('dateOut').textContent='Choose both dates';return}let days=Math.abs(Date.UTC(...a.split('-').map((n,i)=>i===1?Number(n)-1:Number(n)))-Date.UTC(...b.split('-').map((n,i)=>i===1?Number(n)-1:Number(n))))/86400000;$('dateOut').textContent=fmt(days)+' days';$('dateExplain').textContent='This is the number of full calendar days between the two dates.'};
</script></body></html>
